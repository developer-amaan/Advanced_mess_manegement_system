{
  "name": "messmeter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c green,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 5173",
    "demo": "npm run build && concurrently -k -n API,WEB -c green,cyan \"npm:dev:server\" \"npm:preview\"",
    "test": "node --test",
    "start": "node server/index.js"
  },
  "dependencies": {
    "@zxing/browser": "^0.2.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^18.0.6",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.468.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.4",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^2.0.0"
  },
  "overrides": {
    "shell-quote": "^1.12.0"
  }
}
